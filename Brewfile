# Note for Linux: If you encounter permission issues during installation,
# fix directory ownership first:
#   sudo mkdir -p /home/linuxbrew/.linuxbrew
#   sudo chown -R $(whoami):$(whoami) /home/linuxbrew/.linuxbrew
# Then reinstall Homebrew

