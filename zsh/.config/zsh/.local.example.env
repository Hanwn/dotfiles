# Machine-local environment overrides — copy to .local.env and customize
#
# API keys, tokens, and other secrets belong here (NEVER commit .local.env)
# export GITHUB_TOKEN="ghp_..."
# export OPENAI_API_KEY="sk-..."
# export NPM_TOKEN="npm_..."
#
# Source local scripts
# source "${XDG_DATA_HOME}/some-tool/init.sh"
