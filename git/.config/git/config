[core]
  editor = nvim
  pager = delta

[delta]
  navigate = true
  side-by-side = true
  line-numbers = true

[interactive]
  diffFilter = delta --color-only

[diff]
  tool = nvimdiff

[difftool "nvimdiff"]
  cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""

[merge]
  tool = nvimdiff
  conflictStyle = zdiff3

[mergetool]
  keepBackup = false
  prompt = false

[mergetool "nvimdiff"]
  cmd = "nvim -d \"$LOCAL\" \"$MERGED\" \"$REMOTE\" -c 'wincmd = | set diffopt+=vertical'"
[core]
  editor = nvim
  pager = delta

[include]
  path = ~/.config/git/config.local
