[core]
    editor = nvim
    pager = hunk pager
    quotepath = false

[color]
    ui = auto

[column]
    ui = auto

[status]
    showUntrackedFiles = all
    showStash = true

[init]
    defaultBranch = main

[push]
    autoSetupRemote = true
    followTags = true

[pull]
    rebase = true

[fetch]
    prune = true
    pruneTags = true

[rebase]
    autoStash = true
    autoSquash = true

[rerere]
    enabled = true
    autoupdate = true

[branch]
    sort = -committerdate

[tag]
    sort = -version:refname

[diff]
    tool = hunk
    algorithm = histogram
    colorMoved = default
    renames = true

[difftool "nvimdiff"]
    cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""

[merge]
	tool = ec
  conflictStyle = zdiff3

[mergetool]
    keepBackup = false
    prompt = false

[mergetool "ec"]
	cmd = ec \"$BASE\" \"$LOCAL\" \"$REMOTE\" \"$MERGED\"
  trustExitCode = false

[mergetool "nvimdiff"]
    cmd = "nvim -d \"$LOCAL\" \"$MERGED\" \"$REMOTE\" -c 'wincmd = | set diffopt+=vertical'"

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true

[interactive]
    diffFilter = delta --color-only

[include]
    path = ~/.config/git/config.local

[alias]
    st = status --short --branch
    co = checkout
    sw = switch
    br = branch
    ci = commit
    amend = commit --amend --no-edit
    unstage = restore --staged
    last = log -1 HEAD --stat
    la = log --all --date=short --pretty=format:'%C(yellow)%h %C(cyan)%ad %C(green)%an%C(reset) %s%C(auto)%d'
    lg = log --oneline --graph --decorate --all
    ll = log --graph --pretty=format:'%C(yellow)%h%Creset %C(cyan)%ad%Creset %Cgreen%an%Creset %s%C(auto)%d' --date=short
    filelog = log --follow --stat --
